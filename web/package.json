{
  "name": "@pixelcam/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "cf:deploy": "pnpm build && wrangler deploy",
    "cf:preview": "pnpm build && wrangler dev",
    "cf:check": "pnpm build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@pixelcam/ai": "workspace:*",
    "@pixelcam/shared": "workspace:*",
    "onnxruntime-web": "1.26.0-dev.20260416-b7804b056c",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
