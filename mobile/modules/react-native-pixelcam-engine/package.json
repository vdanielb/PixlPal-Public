{
  "name": "react-native-pixelcam-engine",
  "version": "0.1.0",
  "description": "Rust pixel-processing engine turbo module for PixlPal",
  "main": "./src/index.tsx",
  "types": "./src/index.tsx",
  "source": "./src/index.tsx",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "ubrn.config.yaml",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "ubrn:ios": "ubrn build ios --config ubrn.config.yaml --and-generate",
    "ubrn:android": "ubrn build android --config ubrn.config.yaml --and-generate",
    "ubrn:bindings": "bash scripts/generate-bindings.sh",
    "ubrn:clean": "rm -rf cpp/generated src/generated src/Native*.ts src/index.ts*"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "rust",
    "uniffi"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vdanielb/PixelCamAI.git"
  },
  "author": "PixlPal <contact@pixlpal.com>",
  "license": "MIT",
  "homepage": "https://pixlpal.com",
  "dependencies": {
    "@ubjs/core": "^0.31.0-3",
    "uniffi-bindgen-react-native": "^0.31.0-3"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "react": "19.2.3",
    "react-native": "0.85.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "codegenConfig": {
    "name": "PixelcamEngineSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.pixelcamengine"
    }
  }
}
